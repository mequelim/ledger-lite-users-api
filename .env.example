DATABASE_NAME=${DEFAULT_DATABASE_NAME}
DATABASE_PASSWORD=${DEFAULT_PASSWORD}

# JWT settings:
JWT_SECRET=
JWT_EXPIRATION_MINUTES=

# Logging settings:
LOG_LEVEL=
LOG_PATH=