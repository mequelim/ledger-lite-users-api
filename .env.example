ASPNETCORE_ENVIRONMENT=

# Default Values:
DEFAULT_USER=
DEFAULT_PASSWORD=
DEFAULT_DATABASE_NAME=

# PostgreSQL settings:
POSTGRES_USER=${DEFAULT_USER}
POSTGRES_PASSWORD=${DEFAULT_PASSWORD}
POSTGRES_DATABASE=${DEFAULT_DATABASE_NAME}

# API database settings:
DATABASE_HOST=${DEFAULT_USER}
DATABASE_PORT=
